# Keep Flutter source languages visible in GitHub Linguist language stats.
# Ensure example app source is counted in language stats.
examples/** -linguist-vendored -linguist-documentation

*.dart linguist-language=Dart linguist-detectable=true linguist-generated=false
*.kt linguist-language=Kotlin linguist-detectable=true linguist-generated=false
*.kts linguist-language=Kotlin linguist-detectable=true linguist-generated=false
*.swift linguist-language=Swift linguist-detectable=true linguist-generated=false
*.m linguist-language=Objective-C linguist-detectable=true linguist-generated=false
*.mm linguist-language=Objective-C++ linguist-detectable=true linguist-generated=false
*.cc linguist-language=C++ linguist-detectable=true linguist-generated=false
*.cpp linguist-language=C++ linguist-detectable=true linguist-generated=false
*.h linguist-detectable=true linguist-generated=false

# Ignore generated plugin registrant files so they do not skew percentages.
**/GeneratedPluginRegistrant.* linguist-generated=true
**/generated_plugin_registrant.* linguist-generated=true